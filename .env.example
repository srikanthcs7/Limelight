# --- OpenAI ---
# Used for BOTH the tracked engine (Responses API + web_search) and the intel
# jobs (prompt generation, entity extraction, gap recommendations).
OPENAI_API_KEY=sk-...

# Model used for the tracked-engine calls (Responses API + web_search).
OPENAI_ENGINE_MODEL=gpt-4o
# Model used for intel jobs (extraction / generation). Cheaper is fine.
OPENAI_INTEL_MODEL=gpt-4o-mini

# --- Database ---
# App + worker use the POOLED connection.
# Local Compose: postgres service. Deployment: Supabase pooled URL (port 6543).
DATABASE_URL=postgresql+psycopg://limelight:limelight@postgres:5432/limelight
# Alembic migrations use the DIRECT connection (Supabase: port 5432, non-pooled).
# Locally this can be the same as DATABASE_URL.
DATABASE_URL_DIRECT=postgresql+psycopg://limelight:limelight@postgres:5432/limelight

# --- Redis (Celery broker + result backend) ---
# Local Compose: redis service. Deployment: Upstash rediss:// URL.
REDIS_URL=redis://redis:6379/0

# --- App ---
# Comma-separated allowed CORS origins for the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173
# Shared secret for write endpoints (seed, trigger run). Set a long random value
# in deployment; the dashboard prompts for it and sends it as X-Admin-Token.
# If empty, write endpoints are disabled (503).
ADMIN_TOKEN=
